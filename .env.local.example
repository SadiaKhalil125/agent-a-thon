# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# The app targets any OpenAI-compatible gateway via these three variables;
# the provider is chosen entirely here, not in code.

LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=sk-your-key

# The legacy LITELLM_* names are also accepted as a fallback, if you prefer:
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=
